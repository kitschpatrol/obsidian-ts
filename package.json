{
	"name": "obsidian-ts",
	"version": "0.3.0",
	"description": "Fully-typed wrapper library for the Obsidian CLI.",
	"keywords": [
		"obsidian",
		"cli",
		"typescript",
		"pkm",
		"obsidian-md",
		"obsidian-cli",
		"npm-package"
	],
	"homepage": "https://github.com/kitschpatrol/obsidian-ts",
	"bugs": "https://github.com/kitschpatrol/obsidian-ts/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/obsidian-ts.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"files": [
		"dist/*"
	],
	"scripts": {
		"build": "tsdown",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"prepare": "skills experimental_sync -y -f",
		"release": "bumpp --commit 'Release: %s' && pnpm build && pnpm publish --otp $(op item get npm --otp)",
		"test": "vitest run"
	},
	"dependencies": {
		"lognow": "^0.8.4",
		"semver": "^7.8.5",
		"tinyexec": "^1.3.1",
		"type-fest": "^5.10.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@kitschpatrol/shared-config": "^8.12.1",
		"@types/node": "~24.1.0",
		"@types/semver": "^7.8.0",
		"bumpp": "^12.3.0",
		"publint": "^0.3.25",
		"shx": "^0.4.0",
		"skills": "^1.7.0",
		"tsdown": "^0.23.0",
		"typescript": "~6.0.3",
		"vitest": "^5.0.3"
	},
	"packageManager": "pnpm@12.9.1",
	"engines": {
		"node": "^24.1.0 || >=26.0.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.16.0 || >=26.3.0"
		}
	}
}
